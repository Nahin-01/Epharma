# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=ePharmacy

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://tohanahin121_db_user:<db_password>@cluster0.uvkbek6.mongodb.net/?appName=Cluster0
# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Local JWT auth (self-contained, no external dependency required to run).
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# Optional: Google Sign-In. When unset, the /auth/google endpoint responds
# with a clear 501 instead of pretending to authenticate the user.
GOOGLE_CLIENT_ID=

# Optional: Supabase Auth integration. When AUTH_STRATEGY=supabase the auth
# middleware verifies Supabase-issued JWTs instead of local tokens.
AUTH_STRATEGY=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=prescriptions

# ---------------------------------------------------------------------------
# Redis / Queues
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
DOCTOR_URL=http://localhost:5175
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------------------------------------------------------------------------
# File storage (prescriptions, product images)
# ---------------------------------------------------------------------------
# STORAGE_PROVIDER: local | supabase | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
SIGNED_URL_EXPIRES_IN_MINUTES=15
MAX_FILE_SIZE_MB=10
MAX_PRESCRIPTION_FILES=5

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# OCR_PROVIDER: mock | google-vision | textract
OCR_PROVIDER=mock
OCR_API_KEY=your_ocrspace_api_key
OCR_API_URL=https://api.ocr.space/parse/image

# ---------------------------------------------------------------------------
# SMS / OTP
# ---------------------------------------------------------------------------
# SMS_PROVIDER: mock | twilio | bulksmsbd
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER_ID=ePharmacy

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Default gateway used when a client does not force one. Individual gateways
# fall back to a safe sandbox/mock mode automatically when credentials are
# not configured, so checkout keeps working end to end in development.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=testbox
SSLCOMMERZ_IS_LIVE=false

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com

ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_API_SECRET=
ROCKET_BASE_URL=

# ---------------------------------------------------------------------------
# Courier
# ---------------------------------------------------------------------------
# COURIER_PROVIDER: mock | pathao | steadfast | redx
COURIER_PROVIDER=mock
COURIER_API_KEY=
COURIER_API_SECRET=
COURIER_BASE_URL=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
DEFAULT_DELIVERY_CHARGE=60
FREE_DELIVERY_THRESHOLD=1000
