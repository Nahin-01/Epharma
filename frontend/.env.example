# Base URL of the ePharmacy backend API (see ../backend).
# Must match VITE_API_BASE_URL exactly, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Auth project settings (Supabase Dashboard -> Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (from Google Cloud Console -> Credentials).
# Must be the SAME client ID set as GOOGLE_CLIENT_ID in the backend .env.
# Leave unset and the "Continue with Google" button shows a friendly
# not-configured message instead of a broken sign-in flow.
VITE_GOOGLE_CLIENT_ID=
